# 本地开发（npm run dev）用的环境变量示例。
# 复制成 .dev.vars 后填入真实值 —— .dev.vars 已被 .gitignore 忽略，切勿提交真实密钥。
#
# 线上环境不走这个文件：密钥用 `wrangler secret put <NAME>` 写入，
# 非密钥配置（如 GEMINI_MODEL）写在 wrangler.jsonc / wrangler.gemini.jsonc 的 vars 里。

# /api/judge 的调用方鉴权（x-judge-key），必填、无兜底
JUDGE_KEY=replace-with-a-random-key

# 审核后端：workers-ai | gemini
JUDGE_PROVIDER=gemini

# 仅 JUDGE_PROVIDER=gemini 需要
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=replace-with-model-id
